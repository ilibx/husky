# Husky 企业级智能工单系统 - 环境变量配置示例

# ==================== 应用配置 ====================
APP_NAME=husky
APP_ENV=development
APP_PORT=8080
APP_DEBUG=true
APP_LOG_LEVEL=debug

# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=husky
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=1h

# ==================== Redis 配置 ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=100

# ==================== JWT 认证配置 ====================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=24h
JWT_ISSUER=husky-api

# ==================== LLM/AI 配置 ====================
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# ==================== 向量数据库配置 ====================
VECTOR_DIMENSION=1536
VECTOR_INDEX_TYPE=ivfflat
VECTOR_LISTS=100

# ==================== 文件存储配置 ====================
STORAGE_TYPE=local
STORAGE_PATH=./storage
STORAGE_MAX_SIZE=10485760
STORAGE_ALLOWED_TYPES=image/jpeg,image/png,image/gif,application/pdf,application/msword

# ==================== 通知配置 ====================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=noreply@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM=Husky Support <noreply@example.com>

# ==================== 飞书/Lark 配置 ====================
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxx
FEISHU_ENCRYPT_KEY=xxxxxxxxxxxxxxxx

# ==================== 监控配置 ====================
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=husky-api

# ==================== CORS 配置 ====================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
