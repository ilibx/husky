# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=husky
DB_SSLMODE=disable

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 服务器配置
SERVER_PORT=8080
SERVER_MODE=debug
LOG_LEVEL=info
LOG_FORMAT=json

# JWT 配置
JWT_SECRET=husky-secret-key-change-in-production
JWT_EXPIRE_HOUR=24

# LLM 配置
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# 向量数据库配置
VECTOR_DB_PROVIDER=pgvector
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5432
